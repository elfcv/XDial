@@ -167,0 +178 @@ func newXDialLiveness(cSess *ConnSession, header http.Header) *xdialLiveness {
+			deadPeerTimeout:     tlsDeadPeerTimeout,
@@ -175,0 +187 @@ func newXDialLiveness(cSess *ConnSession, header http.Header) *xdialLiveness {
+			deadPeerTimeout:     dtlsDeadPeerTimeout,
@@ -220,0 +233,16 @@ func effectiveXDialDPD(force time.Duration, negotiatedSeconds int) time.Duration
+// effectiveXDialDeadPeerTimeout keeps force-DPD as an early probe interval,
+// but does not let it shorten the server's negotiated DPD window. This keeps
+// fast failure detection on ordinary links without tearing down a healthy
+// session after a brief high-latency or lossy-network stall.
+func effectiveXDialDeadPeerTimeout(
+	probe time.Duration,
+	negotiatedSeconds int,
+) time.Duration {
+	timeout := 2 * probe
+	negotiated := time.Duration(negotiatedSeconds) * time.Second
+	if negotiated > timeout {
+		return negotiated
+	}
+	return timeout
+}
+
