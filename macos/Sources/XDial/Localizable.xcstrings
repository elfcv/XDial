{
  "sourceLanguage": "en",
  "strings": {
    "line.address.missing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Address not obtained"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址未获取"
          }
        }
      }
    },
    "line.address.retryHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click to query this address again. The Line connection is unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击重新查询此地址，不改变线路连接。"
          }
        }
      }
    },
    "line.address.retryLabel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry address lookup"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新查询地址"
          }
        }
      }
    },
    "line.address.updateFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Address update failed. Click to query again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址更新失败，点击重新查询。"
          }
        }
      }
    },
    "line.address.display": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display address"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示地址"
          }
        }
      }
    },
    "line.address.query": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looking up address"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在获取地址"
          }
        }
      }
    },
    "line.address.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不可用"
          }
        }
      }
    },
    "feedback.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report a problem, diagnose a failure, adjust configuration, or refine a suggestion with an AI assistant on this Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "反馈问题、排查故障、调整配置或整理建议，交给你本机的 AI 助手。"
          }
        }
      }
    },
    "feedback.kind": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I want to"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我想要"
          }
        }
      }
    },
    "feedback.kind.problem": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report a problem"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "报告问题"
          }
        }
      }
    },
    "feedback.kind.diagnosis": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnose a failure"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排查故障"
          }
        }
      }
    },
    "feedback.kind.configuration": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust configuration"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整配置"
          }
        }
      }
    },
    "feedback.kind.suggestion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggest a feature"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提出建议"
          }
        }
      }
    },
    "feedback.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe your problem or idea"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "描述你的问题或想法"
          }
        }
      }
    },
    "feedback.placeholder.problem": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What happened, and what did you expect?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发生了什么？你原本期望怎样？"
          }
        }
      }
    },
    "feedback.placeholder.diagnosis": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For example: a website stopped opening after switching Scenarios."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：切换场景后某个网站打不开。"
          }
        }
      }
    },
    "feedback.placeholder.configuration": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For example: use the work Line for company domains, and connect directly for other traffic."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：公司域名走办公线路，其他流量保持直连。"
          }
        }
      }
    },
    "feedback.placeholder.suggestion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is getting in your way? How would you like XDial to improve?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你想解决什么不便？希望 XDial 怎样改进？"
          }
        }
      }
    },
    "feedback.includeDiagnostics": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Include a diagnostic snapshot"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附带诊断快照"
          }
        }
      }
    },
    "feedback.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The automatic snapshot includes versions and connection/task states, without configuration, credentials, addresses, or raw logs. Your own description is shared as written."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动快照仅含版本、连接与任务状态，不含配置、凭据、地址或原始日志。你填写的内容会原样交给助手。"
          }
        }
      }
    },
    "feedback.preview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview handoff contents"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览交接内容"
          }
        }
      }
    },
    "feedback.assistant": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI assistant on this Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机 AI 助手"
          }
        }
      }
    },
    "feedback.refresh": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detect assistants again and refresh the diagnostic snapshot"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新检测助手并刷新诊断快照"
          }
        }
      }
    },
    "feedback.noAssistant": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No supported AI assistant was detected. Download Cindy, then return here to continue. Your draft will be kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未检测到支持的 AI 助手。下载 Cindy 后回到这里继续，已填写的内容会保留。"
          }
        }
      }
    },
    "feedback.download": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download Cindy…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载 Cindy…"
          }
        }
      }
    },
    "feedback.continue": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy and continue in %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制并在 %@ 中继续"
          }
        }
      }
    },
    "feedback.handoffHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies the feedback text and a text file, then opens the assistant. Paste into a new conversation and send, or attach the file manually. Configuration help uses the assistant’s existing permissions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会复制反馈文字及文本文件并打开助手。请在新对话中粘贴发送；也可手动添加文件。配置修改由助手在已有权限内协助完成。"
          }
        }
      }
    },
    "feedback.copy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy feedback contents"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制反馈内容"
          }
        }
      }
    },
    "feedback.reveal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show text file"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看文本文件"
          }
        }
      }
    },
    "feedback.copied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback text and file copied. Paste into an AI conversation. Nothing has been submitted to the developer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "反馈文字和文本文件已复制，可以粘贴到 AI 对话。尚未向开发者提交。"
          }
        }
      }
    },
    "feedback.opened": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ opened. Paste into a new conversation and send. Nothing has been submitted to the developer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已打开 %@。请在新对话中粘贴发送，尚未提交给开发者。"
          }
        }
      }
    },
    "feedback.openFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not open the selected assistant. Select it again and retry, or copy the feedback and send it manually."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能打开所选助手。请重新选择后重试，或复制反馈内容手动发送。"
          }
        }
      }
    },
    "feedback.exportFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not create or copy the feedback file. Retry, or copy your description manually."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能生成或复制反馈文件。请重试；仍未成功时，可先复制你填写的描述。"
          }
        }
      }
    },
    "feedback.downloadFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not open the download page. Visit cindy.app/download/ in your browser."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能打开下载页。请在浏览器访问 cindy.app/download/。"
          }
        }
      }
    },
    "feedback.choose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 %@"
          }
        }
      }
    },
    "feedback.assistantUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previously selected assistant is no longer available. Choose an assistant before continuing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之前选择的助手已不可用。请选择要使用的助手，再继续交接。"
          }
        }
      }
    },
    "feedback.newConversation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New conversation in %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %@ 中新建对话"
          }
        }
      }
    },
    "feedback.folderHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens a new conversation in this diagnostic directory, where the text file is saved. Paste the copied contents into the new conversation and send."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将打开本次诊断目录并进入新对话，文本文件已放在该目录中。请在新对话中粘贴已复制的内容后发送。"
          }
        }
      }
    },
    "feedback.codexHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens a new conversation with an instruction to read the diagnostic file. Review it and send. The feedback text and file are also copied for manual use."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将打开新对话并预填读取诊断文件的说明，确认后点击发送。反馈文字与文件也会复制，便于手动使用。"
          }
        }
      }
    },
    "feedback.folderRequested": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requested a new conversation in %@ with this diagnostic directory. Paste the copied contents and send."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已请求在 %@ 中新建对话，并打开本次诊断目录。请粘贴已复制的内容后发送。"
          }
        }
      }
    },
    "feedback.codexRequested": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requested a new conversation in %@. Review the prefilled instruction and send; if it did not appear, paste the copied contents."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已请求在 %@ 中新建对话。请检查预填说明后发送；若未出现，可粘贴已复制的内容。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
